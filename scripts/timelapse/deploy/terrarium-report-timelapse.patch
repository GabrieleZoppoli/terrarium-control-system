+def _timelapse_section():
+    """Flowers section from /opt/terrarium-timelapse; any failure leaves the report unchanged."""
+    try:
+        if "/opt/terrarium-timelapse" not in sys.path:
+            sys.path.append("/opt/terrarium-timelapse")
+        from timelapse.report_section import timelapse_section
+        r = timelapse_section("/var/lib/terrarium-timelapse", datetime.now())
+        return {"lines": [str(x) for x in r.get("lines") or []], "checkin": r.get("checkin")}
+    except Exception:
+        return {"lines": [], "checkin": None}
