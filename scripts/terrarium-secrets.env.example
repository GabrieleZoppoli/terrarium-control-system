# /etc/terrarium/secrets.env  (chmod 600, owned by pi)
# Read by terrarium-health.py and terrarium-report.py. KEY=VALUE, no spaces
# around "=". Lines starting with # are ignored. Never commit the real file.

# Gmail (use an App Password, not the account password)
TERRARIUM_GMAIL_ADDRESS=sender@gmail.com
TERRARIUM_GMAIL_APP_PASS=abcdabcdabcdabcd
TERRARIUM_GMAIL_TO=you@example.com
# Optional: send the daily report somewhere else (comma-separated)
# TERRARIUM_REPORT_TO=you@example.com,partner@example.com

# Tapo + WhatsApp (health check)
TERRARIUM_TAPO_EMAIL=
TERRARIUM_TAPO_PASS=
TERRARIUM_WHATSAPP_PHONE=
TERRARIUM_CALLMEBOT_KEY=

# Health check: periodic "all green" email every N hours. 0 = off (the daily
# report is the heartbeat now). Set to 6 to get the old behaviour back.
TERRARIUM_GREEN_EMAIL_HOURS=0

# ── Report tuning (all optional; defaults shown) ──
# TERRARIUM_BASELINE_DAYS=7
# TERRARIUM_KWH_PRICE=0.30
# TERRARIUM_TEMP_HIGH=25.0
# TERRARIUM_TEMP_LOW=10.0
# TERRARIUM_HUMI_LOW=65
# TERRARIUM_TEMP_BAND=1.0
# TERRARIUM_HUMI_BAND=5
# TERRARIUM_WATER_WARN=15
# TERRARIUM_WATER_RED=5
# TERRARIUM_WATER_ETA_WARN_DAYS=2
# TERRARIUM_SHORT_CYCLE_MIN=5
# TERRARIUM_SHORT_CYCLE_WARN=3
# TERRARIUM_GAP_WARN_MIN=30
# TERRARIUM_DISK_WARN_PCT=85
# TERRARIUM_CPU_TEMP_WARN=75
# TERRARIUM_Z_WARN=3
# TERRARIUM_SERVICES=nodered,influxdb,grafana-server,meross-daemon,conditions-server,arduino-watchdog
# TERRARIUM_REPORT_DIR=/home/pi/terrarium-reports
# TERRARIUM_LEDGER=/home/pi/.terrarium-health-ledger.jsonl
