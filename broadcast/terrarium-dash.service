[Unit]
Description=Terrarium broadcast - Node-RED dashboard MJPEG grabber (puppeteer)
After=network-online.target nodered.service
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/terrarium-broadcast
ExecStart=/usr/bin/node /home/pi/terrarium-broadcast/dash-stream.mjs
Restart=always
RestartSec=5
Nice=10

[Install]
WantedBy=multi-user.target
